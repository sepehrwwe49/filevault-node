###############################################################################
#  FileVault Node - per-server settings
#  Filled in by the menu:  sudo fv  ->  option 1
###############################################################################

# Subdomains served by this node (first one = primary, used for the certificate)
SITE_DOMAINS=cdn.example.com,files.example.com

# Reality domains handled by this node (raw SNI passthrough, configs untouched)
REALITY_DOMAINS=

# Local Xray ports - must match the inbounds in the panel
XRAY_REALITY_PORT=12000
XRAY_XHTTP_PORT=12001
# XHTTP path exactly as it appears in the client config.
# Use "/" when the config has path=/ or path=/?ed=2048  (root-path mode).
XRAY_XHTTP_PATH=/

# Internal nginx TLS port (no need to change)
LOCAL_TLS_PORT=8443

# Panel and SSH ports (firewall only)
PANEL_PORT=2053
SSH_PORT=22
EXTRA_OPEN_PORTS=
# Set to 1 only if you really need UDP/443 open
OPEN_QUIC=0

# Cloudflare DNS-01. Token scope: Zone:Zone:Read + Zone:DNS:Edit
CF_API_TOKEN=
LE_EMAIL=admin@example.com

# Upload site
MAX_UPLOAD_MB=50
RETENTION_DAYS=7
SITE_NAME=FileVault
