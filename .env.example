###############################################################################
#  FileVault Node — تنظیمات این سرور
#  با منو پر می‌شود:  sudo fv → گزینه ۱
###############################################################################

# ساب‌دامنه‌هایی که روی این نود برای XHTTP/TLS استفاده می‌شوند (اولی = دامنه اصلی)
SITE_DOMAINS=cdn.tasmino.ir,files.tasmino.ir

# دامنه‌های Reality این نود (خام پاس داده می‌شوند، کانفیگشان دست‌نخورده می‌ماند)
REALITY_DOMAINS=re1.tasmino.ir

# پورت‌های لوکال ایکس‌ری (همان‌هایی که در اینباندهای پنل ست می‌کنی)
XRAY_REALITY_PORT=12000
XRAY_XHTTP_PORT=12001
XRAY_XHTTP_PATH=xhttp

# پورت داخلی nginx برای سایت TLS (لازم نیست عوض شود)
LOCAL_TLS_PORT=8443

# پنل پاسارگاد و SSH (فقط برای فایروال)
PANEL_PORT=2053
SSH_PORT=22
EXTRA_OPEN_PORTS=

# کلودفلر (DNS-01)  — اسکوپ توکن: Zone:Zone:Read + Zone:DNS:Edit
CF_API_TOKEN=
LE_EMAIL=admin@example.com

# سایت آپلود
MAX_UPLOAD_MB=50
RETENTION_DAYS=7
SITE_NAME=FileVault
