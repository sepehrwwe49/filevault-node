upstream php_backend   { server 127.0.0.1:9000; keepalive 16; }
upstream xhttp_backend { server 127.0.0.1:__XHTTP_PORT__; keepalive 64; }

# ---------- plain HTTP (Cloudflare :80 ports + ACME fallback) ----------------
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    location /.well-known/acme-challenge/ { root /var/www/acme; }

__XHTTP_LOC_80__

    location / { return 301 https://$host$request_uri; }
}

# ---------- TLS terminated site (fed by the stream layer) --------------------
server {
    listen 127.0.0.1:__LOCAL_TLS_PORT__ ssl;
    http2 on;
    server_name _;

    ssl_certificate     /etc/letsencrypt/live/__PRIMARY__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__PRIMARY__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:20m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    root /var/www/site;
    index index.php;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

__XHTTP_LOC_443__

    # ===== normal website =====
    location = /robots.txt   { try_files /robots.txt =404; }
    location = /sitemap.xml  { try_files /sitemap.xml =404; }

    location /f/ { alias /var/www/data/uploads/; internal; }

    location ~ \.php$ {
        fastcgi_pass php_backend;
        fastcgi_index index.php;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME /var/www/site$fastcgi_script_name;
        fastcgi_read_timeout 300s;
        client_max_body_size __MAX_UPLOAD_MB__m;
    }

    location ~* \.(css|js|svg|png|ico|woff2)$ {
        expires 7d;
        add_header Cache-Control "public, max-age=604800";
    }

    location ~ ^/d/([A-Za-z0-9]{6,32})$ {
        rewrite ^/d/([A-Za-z0-9]{6,32})$ /d.php?id=$1 last;
    }

__ROOT_LOC__

    error_page 404 /404.php;
    location = /404.php {
        fastcgi_pass php_backend;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME /var/www/site/404.php;
    }
}
