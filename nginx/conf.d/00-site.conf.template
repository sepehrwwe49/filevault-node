upstream php_backend   { server 127.0.0.1:9000; keepalive 16; }
upstream xhttp_backend { server 127.0.0.1:__XHTTP_PORT__; keepalive 64; }

# ---------- plain HTTP (Cloudflare http ports, ACME, and the website) --------
server {
__HTTP_LISTEN__
    server_name _;

    root /var/www/site;
    index index.php;

    location /.well-known/acme-challenge/ { root /var/www/acme; }

__XHTTP_LOC__

    include /etc/nginx/conf.d/site_common.inc;
}

# ---------- TLS terminated site (fed by the stream layer) --------------------
server {
    listen 127.0.0.1:__LOCAL_TLS_PORT__ ssl;
    http2 on;
    server_name _;

    ssl_certificate     __CERT_DIR__/fullchain.pem;
    ssl_certificate_key __CERT_DIR__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:20m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    root /var/www/site;
    index index.php;

__XHTTP_LOC__

    include /etc/nginx/conf.d/site_common.inc;
}
